# Node.js .gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm/

# dotenv environment files
.env
.env.test
.env.production

# Optional eslint cache
.eslintcache

# IDEs and editors
.vscode/
.idea/

# Build output
dist/
build/

# OS-specific files
.DS_Store
Thumbs.db
