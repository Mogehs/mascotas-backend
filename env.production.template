# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB - VPS Local Installation
DATABASE=mongodb://localhost:27017/mascotas-backend

# Base URL - CHANGE THIS to your actual domain
BASE_URL=https://api.yourdomain.com

# JWT Secret - CHANGE THIS TO A STRONG RANDOM STRING
JWT_SECRET_KEY=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_PORT=587

# Stripe Payment Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_webhook_secret

# Firebase Cloud Messaging
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Google API
GOOGLE_API_KEY=your_google_api_key

# CORS - Add your frontend domain
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
